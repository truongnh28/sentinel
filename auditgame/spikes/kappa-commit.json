  "verdict": "kappa_commit / kappa_bar >= 4.00 from the review half alone, which is already above the 1.43-2.0 crossover band. Adding the measured test cost only raises it. The sign of RQ1 does NOT depend on the CPU price.",
  "breakeven_usd_per_cpu_second": {
    "1.43": {
      "usd_per_cpu_second": -0.00664215,
      "meaning": "no price can reach this ratio: the review half (0.006192 USD) already exceeds 1.43 x kappa_bar (0.002214 USD), so kappa_commit/kappa_bar is above the crossover at ANY non-negative CPU price"
    },
    "2.0": {
      "usd_per_cpu_second": -0.00516899,
      "meaning": "no price can reach this ratio: the review half (0.006192 USD) already exceeds 2.0 x kappa_bar (0.003096 USD), so kappa_commit/kappa_bar is above the crossover at ANY non-negative CPU price"
    }
  },
  "reading": "kappa_commit(r) = review + T_test * r, with r the USD price of a CPU second. B1 keeps winning only while kappa_commit stays below about 2.0 * kappa_bar, so the breakeven r above is the price at which the answer changes. Compare it with the machine bill rather than picking a number here.",
  "caveats": [
    "tests run at HEAD, not at base_commit -- era pinning needs the per-instance Docker images this project does not have",
    "environment build time is measured and EXCLUDED: paid once per machine, not once per audit",
    "repos needing compiled dependencies are skipped, with the reason"
  ],
